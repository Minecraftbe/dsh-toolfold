{
  "name": "dsh-toolfold",
  "version": "0.1.8",
  "description": "工具调用与思考的折叠显示：连续工具调用折叠为最后一个调用（可展开），已完成的思考随组折叠（可保留、展开时按原顺序显示），进行中的思考保持独立显示。",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minecraftbe/dsh-toolfold.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test:engine": "node tools/engine-smoke.mjs",
    "probe:live": "node tools/live-probe.mjs",
    "install:dsh": "node scripts/install-dsh.cjs",
    "uninstall:dsh": "node scripts/install-dsh.cjs uninstall"
  },
  "engines": {
    "dsh": ">=0.1.2-rc.1 <0.1.3"
  },
  "peerDependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  },
  "license": "MIT"
}
